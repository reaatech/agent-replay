{
  "name": "@reaatech/agent-replay-core",
  "version": "0.1.0",
  "description": "Core recording and replay engine for Agent Replay",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "homepage": "https://github.com/reaatech/agent-replay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/agent-replay.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/reaatech/agent-replay/issues"
  },
  "keywords": ["agent", "replay", "llm", "debugging", "testing"],
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "@reaatech/agent-replay-shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^3.1.1"
  }
}
