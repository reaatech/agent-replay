{
  "name": "@reaatech/agent-replay",
  "version": "0.1.0",
  "description": "Main package for Agent Replay — re-exports core and interceptors",
  "license": "MIT",
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "homepage": "https://github.com/reaatech/agent-replay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reaatech/agent-replay.git",
    "directory": "packages/agent-replay"
  },
  "bugs": {
    "url": "https://github.com/reaatech/agent-replay/issues"
  },
  "keywords": [
    "agent",
    "replay",
    "llm",
    "debugging",
    "testing"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "dependencies": {
    "@reaatech/core": "workspace:*",
    "@reaatech/interceptors": "workspace:*",
    "@reaatech/shared": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
